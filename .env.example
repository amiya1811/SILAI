# ========================================================
# SILAI - Environment Configuration Template
# ========================================================

# Application Mode & URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database Configuration (PostgreSQL in production, SQLite supported for local dev)
DATABASE_URL="postgresql://silai_user:silai_secure_password@localhost:5432/silai_db?schema=public"

# Authentication Secrets (Generate with `openssl rand -base64 32`)
AUTH_SECRET="silai_super_secret_jwt_key_development_change_in_production_2026"
COOKIE_SECURE="false"

# Razorpay Payment Gateway (Test Credentials)
# Client-side safe public key:
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_silai_demo_key"
# Server-side ONLY private secrets (NEVER expose to frontend):
RAZORPAY_KEY_SECRET="silai_razorpay_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="silai_webhook_secret_placeholder"

# Object Storage (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_ENDPOINT="https://s3.ap-south-1.amazonaws.com"
STORAGE_BUCKET="silai-designs-storage"
STORAGE_ACCESS_KEY="silai_storage_access_key"
STORAGE_SECRET_KEY="silai_storage_secret_key"
STORAGE_PUBLIC_URL="https://storage.silai.luxury"

# Rate Limiting & Security
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
